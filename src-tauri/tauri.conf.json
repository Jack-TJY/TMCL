{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMCL",
  "version": "0.1.0",
  "identifier": "io.github.jack-tjy.tmcl",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TMCL",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "JIANYU TANG",
    "homepage": "https://github.com/Jack-TJY/TMCL",
    "copyright": "Copyright (C) 2026 TMCL contributors. Licensed under GPL-3.0-only.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Game",
    "shortDescription": "Open-source Minecraft: Java Edition launcher",
    "longDescription": "TMCL is an open-source, cross-platform launcher for Minecraft: Java Edition. It is an unofficial launcher and is not affiliated with Mojang Studios or Microsoft.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  }
}
