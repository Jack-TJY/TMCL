{
  "name": "tmcl",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "pnpm --dir ui dev",
    "build": "pnpm --dir ui build",
    "typecheck": "pnpm --dir ui typecheck",
    "tauri": "tauri",
    "gen:bindings": "node scripts/gen-bindings.mjs",
    "lint": "pnpm --dir ui lint",
    "format": "pnpm --dir ui format && cargo fmt --all",
    "format:check": "pnpm --dir ui format:check",
    "test": "pnpm --dir ui test",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:ui": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm check:rust && pnpm check:ui"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  }
}
